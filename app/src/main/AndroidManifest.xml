<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 允许访问 aqq 应用的 ContentProvider -->
    <queries>
        <package android:name="dev.huidou.db" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dtool">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dtool">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="fun.huidou.app"
            android:value="true" />
        <meta-data
            android:name="dev.huidou.db"
            android:value="true" />

        <!-- 应用内语言持久化（AppCompat autoStoreLocales 开启；Android 13+ 由系统 LocaleManager 存储） -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>