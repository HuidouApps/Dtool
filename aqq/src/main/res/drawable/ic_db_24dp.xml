<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 左右竖线（默认 butt 端点） -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:pathData="
            M 2,7 L 2,19
            M 22,7 L 22,19" />

    <!-- 顶部完整椭圆（保持圆头，因为闭合） -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="
            M 2,7
            C 2,3 22,3 22,7
            C 22,11 2,11 2,7 Z" />

    <!-- 第二圈：平头端点，与竖线平齐 -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:pathData="
            M 2,10.5
            C 2,14 22,14 22,10.5" />

    <!-- 第三圈 -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:pathData="
            M 2,14
            C 2,17.5 22,17.5 22,14" />

    <!-- 第四圈 -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:pathData="
            M 2,17.5
            C 2,21 22,21 22,17.5" />

    <!-- 底部弧线：平头端点，与竖线底端完美对齐，无突出 -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:pathData="
            M 2,19
            C 2,22 22,22 22,19" />

</vector>